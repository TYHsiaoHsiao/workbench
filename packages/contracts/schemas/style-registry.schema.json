{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "style-registry.schema.json",
  "title": "Style Registry",
  "description": "C 子系统的导演风格注册表：由外部风格包构建的元数据快照（不含图片二进制）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "generated_at", "source", "categories", "entries", "qc"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "generated_at": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_name", "directors", "categories"],
      "properties": {
        "root_name": { "type": "string", "minLength": 1 },
        "root_path": { "type": "string" },
        "directors": { "type": "integer", "minimum": 1 },
        "categories": { "type": "integer", "minimum": 1 },
        "note": { "type": "string" }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "directory", "count"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9]{2}$" },
          "name": { "type": "string", "minLength": 1 },
          "directory": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name_en", "name_zh", "directory", "category", "quality", "issues", "flags"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9]{3}$" },
          "name_en": { "type": "string" },
          "name_zh": { "type": "string" },
          "directory": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "pattern": "^[0-9]{2}$" },
          "category_name": { "type": "string" },
          "nationality": { "type": "string" },
          "palette": {
            "type": "object",
            "additionalProperties": false,
            "required": ["primary", "emotional", "primary_ratio_sum"],
            "properties": {
              "primary": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["code", "hex", "name_zh", "ratio"],
                  "properties": {
                    "code": { "type": "string" },
                    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                    "name_zh": { "type": "string" },
                    "ratio": { "type": "number", "minimum": 0, "maximum": 100 }
                  }
                }
              },
              "emotional": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["code", "hex", "name_zh", "emotion"],
                  "properties": {
                    "code": { "type": "string" },
                    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                    "name_zh": { "type": "string" },
                    "emotion": { "type": "string" }
                  }
                }
              },
              "primary_ratio_sum": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          },
          "style_profile": {
            "type": "object",
            "additionalProperties": false,
            "required": ["definition", "lighting", "framing", "grading", "avoid"],
            "properties": {
              "definition": { "type": "string" },
              "lighting": { "type": "string" },
              "framing": { "type": "string" },
              "grading": { "type": "string" },
              "avoid": { "type": "string" }
            }
          },
          "keywords": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "composition": { "type": "array", "items": { "type": "string" } },
              "color": { "type": "array", "items": { "type": "string" } },
              "mood": { "type": "array", "items": { "type": "string" } }
            }
          },
          "prompts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "midjourney": { "type": "integer", "minimum": 0 },
              "conversational": { "type": "integer", "minimum": 0 },
              "video": { "type": "integer", "minimum": 0 },
              "stable_diffusion": { "type": "integer", "minimum": 0 }
            }
          },
          "references_count": { "type": "integer", "minimum": 0 },
          "quality": { "type": "string", "enum": ["A", "B", "C"] },
          "issues": { "type": "array", "items": { "type": "string" } },
          "flags": {
            "type": "object",
            "additionalProperties": false,
            "required": ["has_palette_json", "has_color_card", "has_prompt_files", "has_references", "has_copyright_note"],
            "properties": {
              "has_palette_json": { "type": "boolean" },
              "has_color_card": { "type": "boolean" },
              "has_prompt_files": { "type": "boolean" },
              "has_references": { "type": "boolean" },
              "has_copyright_note": { "type": "boolean" },
              "broken_image_links": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "qc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade_counts", "issue_counts", "duplicate_palettes"],
      "properties": {
        "grade_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["A", "B", "C"],
          "properties": {
            "A": { "type": "integer", "minimum": 0 },
            "B": { "type": "integer", "minimum": 0 },
            "C": { "type": "integer", "minimum": 0 }
          }
        },
        "issue_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "duplicate_palettes": { "type": "integer", "minimum": 0 },
        "duplicate_palette_groups": { "type": "integer", "minimum": 0 },
        "skipped_directories": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
