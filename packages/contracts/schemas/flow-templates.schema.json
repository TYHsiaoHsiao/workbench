{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flow-templates.schema.json",
  "title": "Flow Templates v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "templates"],
  "properties": {
    "contract_version": { "const": "0.1" },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["template_id", "name", "description", "graph"],
        "properties": {
          "template_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "graph": { "type": "object" }
        }
      }
    }
  }
}
