{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state.schema.json",
  "title": "Project State v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "project",
    "entry",
    "mode",
    "stage",
    "version",
    "authoritative_inputs",
    "gates",
    "references",
    "style_profile",
    "stale_downstream",
    "next_action"
  ],
  "properties": {
    "contract_version": { "const": "1.0" },
    "project": { "type": "string", "minLength": 1 },
    "entry": { "type": "string", "enum": ["A", "B", "C", "D"] },
    "mode": { "type": "string", "enum": ["full", "stage", "relay", "revise"] },
    "stage": { "type": "string", "pattern": "^(0[1-8]|done)$" },
    "version": { "type": "string", "pattern": "^v[0-9]{2}$" },
    "authoritative_inputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "stage": { "type": "string", "pattern": "^0[1-8]$" },
          "status": { "type": "string", "enum": ["pending", "passed", "failed", "waived"] },
          "note": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      }
    },
    "references": {
      "type": "array",
      "items": { "type": "string", "pattern": "^参考方法[0-9]{3}$" }
    },
    "style_profile": { "type": "string" },
    "stale_downstream": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_action": { "type": "string", "minLength": 1 },
    "documents_root": { "type": "string" },
    "projects_root": { "type": "string" },
    "confirmed_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "knowledge_bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["off", "requested", "on"] },
        "last_card": { "type": "string" },
        "confirmed_references": {
          "type": "array",
          "items": { "type": "string", "pattern": "^参考方法[0-9]{3}$" }
        },
        "note": { "type": "string" }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["off", "requested", "on"] },
        "profile_path": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "stage_artifacts": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "revision_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "action"],
        "properties": {
          "at": { "type": "string" },
          "action": { "type": "string" },
          "stage": { "type": "string", "pattern": "^(0[1-8]|done)$" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
