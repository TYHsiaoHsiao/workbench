{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flow Node Types v0.1",
  "type": "object",
  "required": ["contract_version", "types"],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "type": "string", "const": "0.1" },
    "types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "label", "category", "ports", "params_schema", "executor"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "ports": {
            "type": "object",
            "required": ["in", "out"],
            "additionalProperties": false,
            "properties": {
              "in": { "type": "array", "items": { "type": "string" } },
              "out": { "type": "array", "items": { "type": "string" } }
            }
          },
          "params_schema": { "type": "object" },
          "executor": { "type": "string", "minLength": 1 },
          "constraints": { "type": "array", "items": { "type": "string" } },
          "parallel_safe": { "type": "boolean" }
        }
      }
    }
  }
}
