{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generate-providers.schema.json",
  "title": "Generate Providers v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "providers"],
  "properties": {
    "contract_version": { "const": "0.1" },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider_id", "label", "kind", "models"],
        "properties": {
          "provider_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["mock", "video", "image"] },
          "env_key": { "type": "string" },
          "base_url_env": { "type": "string" },
          "models": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "max_chars": { "type": "integer", "minimum": 1 },
          "max_duration_s": { "type": "integer", "minimum": 1 },
          "submit_path": { "type": "string" },
          "status_path": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
