{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-artifact.schema.json",
  "title": "Stage Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "artifact_id",
    "project",
    "stage",
    "version",
    "path",
    "sha256",
    "inputs",
    "references",
    "gates",
    "status",
    "created_at"
  ],
  "properties": {
    "contract_version": { "const": "1.0" },
    "artifact_id": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1 },
    "stage": { "type": "string", "pattern": "^0[1-8]$" },
    "version": { "type": "string", "pattern": "^v[0-9]{2}$" },
    "path": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "inputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "references": {
      "type": "array",
      "items": { "type": "string", "pattern": "^参考方法[0-9]{3}$" }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["pending", "passed", "failed", "waived"] },
          "note": { "type": "string" }
        }
      }
    },
    "status": { "type": "string", "enum": ["draft", "confirmed", "superseded"] },
    "created_at": { "type": "string", "minLength": 1 }
  }
}
