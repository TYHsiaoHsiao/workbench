{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "style-profile.schema.json",
  "title": "Style Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "profile_id",
    "director_no",
    "name",
    "category",
    "tags",
    "palette",
    "lighting",
    "lens",
    "materials",
    "negatives",
    "tool_adapters",
    "quality"
  ],
  "properties": {
    "contract_version": { "const": "1.0" },
    "profile_id": { "type": "string", "minLength": 1 },
    "director_no": { "type": "string", "pattern": "^[0-9]{3}$" },
    "name": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "palette": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "hex", "ratio"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "ratio": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "lighting": { "type": "string", "minLength": 1 },
    "lens": { "type": "string", "minLength": 1 },
    "materials": {
      "type": "array",
      "items": { "type": "string" }
    },
    "negatives": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tool_adapters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mj": { "type": "string" },
        "banana": { "type": "string" },
        "seedance_2_0": { "type": "string" },
        "seedance_2_5": { "type": "string" },
        "h3": { "type": "string" },
        "sd": { "type": "string" },
        "runway": { "type": "string" },
        "pika": { "type": "string" }
      }
    },
    "quality": { "type": "string", "enum": ["A", "B", "C"] }
  }
}
