{
  "contract_version": "0.1",
  "types": [
    {
      "type": "start",
      "label": "开始",
      "category": "入口",
      "description": "流程入口，绑定一个已有项目，并记录入口 A/B/C/D。",
      "ports": {
        "in": [],
        "out": [
          "project"
        ]
      },
      "params_schema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "title": "项目目录或名称"
          },
          "entry": {
            "type": "string",
            "title": "入口",
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ],
            "default": "A"
          },
          "note": {
            "type": "string",
            "title": "备注"
          }
        },
        "required": [
          "project"
        ],
        "additionalProperties": false
      },
      "executor": "start"
    },
    {
      "type": "stage",
      "label": "阶段执行",
      "category": "阶段",
      "description": "执行 01-08 中一个创作阶段；可自动通过该阶段硬门禁后推进。",
      "ports": {
        "in": [
          "state",
          "artifact"
        ],
        "out": [
          "artifact",
          "log"
        ]
      },
      "params_schema": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "title": "阶段",
            "enum": [
              "01",
              "02",
              "03",
              "04",
              "05",
              "06",
              "07",
              "08"
            ]
          },
          "auto_gates": {
            "type": "boolean",
            "title": "自动通过硬门禁",
            "default": true
          },
          "note": {
            "type": "string",
            "title": "备注"
          }
        },
        "required": [
          "stage"
        ],
        "additionalProperties": false
      },
      "executor": "stage"
    },
    {
      "type": "knowledge_search",
      "label": "知识检索",
      "category": "知识",
      "description": "只读检索本地知识库，生成待确认知识卡（不写参考记忆）。",
      "ports": {
        "in": [
          "state"
        ],
        "out": [
          "knowledge_card",
          "log"
        ]
      },
      "params_schema": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "title": "服务阶段",
            "enum": [
              "01",
              "02",
              "03",
              "04",
              "05",
              "06",
              "07",
              "08"
            ]
          },
          "problem": {
            "type": "string",
            "title": "待解问题"
          },
          "queries": {
            "type": "array",
            "title": "查询（lane:查询词）",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "candidates_limit": {
            "type": "integer",
            "title": "候选上限",
            "default": 40,
            "minimum": 1
          },
          "evidence_limit": {
            "type": "integer",
            "title": "证据上限",
            "default": 8,
            "minimum": 1
          },
          "fallback": {
            "type": "boolean",
            "title": "启用有限正文回退",
            "default": true
          },
          "kb_root": {
            "type": "string",
            "title": "知识库根目录（可空）"
          },
          "index": {
            "type": "string",
            "title": "本地索引目录（M22；有值时优先生成索引证据卡）"
          }
        },
        "required": [
          "stage",
          "problem",
          "queries"
        ],
        "additionalProperties": false
      },
      "executor": "knowledge_search",
      "parallel_safe": true
    },
    {
      "type": "style_apply",
      "label": "风格卡",
      "category": "风格",
      "description": "把 200 导演风格包中的一位应用到项目（写风格卡并更新项目状态）。",
      "ports": {
        "in": [
          "state"
        ],
        "out": [
          "style_card",
          "log"
        ]
      },
      "params_schema": {
        "type": "object",
        "properties": {
          "style": {
            "type": "string",
            "title": "风格编号或名称"
          },
          "tool": {
            "type": "string",
            "title": "适配工具（可空）",
            "enum": [
              "mj",
              "banana",
              "seedance_2_0",
              "seedance_2_5",
              "h3",
              "sd",
              "runway",
              "pika"
            ]
          },
          "note": {
            "type": "string",
            "title": "备注"
          }
        },
        "required": [
          "style"
        ],
        "additionalProperties": false
      },
      "executor": "style_apply",
      "parallel_safe": true
    },
    {
      "type": "style_inject",
      "label": "风格注入",
      "category": "风格",
      "description": "把已应用风格卡注入一批提示词（06/08），写批量注入记录。",
      "ports": {
        "in": [
          "state",
          "text"
        ],
        "out": [
          "injection",
          "log"
        ]
      },
      "params_schema": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "title": "阶段",
            "enum": [
              "06",
              "08"
            ]
          },
          "tool": {
            "type": "string",
            "title": "工具",
            "enum": [
              "mj",
              "banana",
              "seedance_2_0",
              "seedance_2_5",
              "h3",
              "sd",
              "runway",
              "pika"
            ]
          },
          "items": {
            "type": "array",
            "title": "提示词条目",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "shot": {
                  "type": "string"
                },
                "prompt": {
                  "type": "string"
                }
              },
              "required": [
                "shot",
                "prompt"
              ],
              "additionalProperties": false
            }
          },
          "per_shot": {
            "type": "boolean",
            "title": "逐条记录",
            "default": true
          }
        },
        "required": [
          "stage",
          "tool",
          "items"
        ],
        "additionalProperties": false
      },
      "executor": "style_inject",
      "parallel_safe": true
    },
    {
      "type": "artifact_register",
      "label": "产物登记",
      "category": "工具",
      "description": "登记阶段产物到项目状态（写 stage_artifacts 与修订日志）。",
      "ports": {
        "in": [
          "state"
        ],
        "out": [
          "artifact",
          "log"
        ]
      },
      "params_schema": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "title": "阶段",
            "enum": [
              "01",
              "02",
              "03",
              "04",
              "05",
              "06",
              "07",
              "08",
              "done"
            ]
          },
          "kind": {
            "type": "string",
            "title": "产物类型"
          },
          "paths": {
            "type": "array",
            "title": "相对路径（支持 glob）",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "note": {
            "type": "string",
            "title": "备注"
          }
        },
        "required": [
          "stage",
          "kind",
          "paths"
        ],
        "additionalProperties": false
      },
      "executor": "artifact_register",
      "parallel_safe": true
    },
    {
      "type": "check_content",
      "label": "内容检查",
      "category": "工具",
      "description": "跨阶段一致性检查（风格卡/知识卡/产物/时长），默认失败即中止。",
      "ports": {
        "in": [
          "state"
        ],
        "out": [
          "log"
        ]
      },
      "params_schema": {
        "type": "object",
        "properties": {
          "fail_on_error": {
            "type": "boolean",
            "title": "有错误即中止",
            "default": true
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "executor": "check_content",
      "parallel_safe": true
    },
    {
      "type": "condition",
      "label": "条件分支",
      "category": "控制",
      "description": "按条件表达式选择 true/false 分支；未选中分支的下游节点会被自动跳过。",
      "ports": {
        "in": [
          "state",
          "artifact",
          "text",
          "card",
          "log"
        ],
        "out": [
          "true",
          "false"
        ]
      },
      "params_schema": {
        "type": "object",
        "properties": {
          "when": {
            "type": "string",
            "title": "条件表达式",
            "default": "always",
            "description": "支持 always / never / state.stage == 05 / state.version >= v03 / iteration >= 2"
          },
          "note": {
            "type": "string",
            "title": "备注"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "executor": "condition",
      "parallel_safe": true
    },
    {
      "type": "loop",
      "label": "循环体",
      "category": "控制",
      "description": "按最大次数/条件重复执行循环体（body 与回边构成单一链条），完成后走 done 分支。",
      "ports": {
        "in": [
          "state"
        ],
        "out": [
          "body",
          "done"
        ]
      },
      "params_schema": {
        "type": "object",
        "properties": {
          "max_iterations": {
            "type": "integer",
            "title": "最大迭代次数",
            "default": 3,
            "minimum": 1,
            "maximum": 10
          },
          "until": {
            "type": "string",
            "title": "提前结束条件",
            "default": "never",
            "description": "支持 never / always / state.stage == 05 / iteration >= 2 等表达式"
          },
          "note": {
            "type": "string",
            "title": "备注"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "executor": "loop"
    },
    {
      "type": "knowledge_adopt",
      "label": "知识卡采纳",
      "category": "知识",
      "description": "把已确认的知识卡写入跨阶段参考记忆（参考方法编号、契约校验、state.references 同步）。",
      "ports": {
        "in": [
          "state",
          "knowledge_card"
        ],
        "out": [
          "reference",
          "log"
        ]
      },
      "params_schema": {
        "type": "object",
        "properties": {
          "card": {
            "type": "string",
            "title": "知识卡路径（相对项目）"
          },
          "max_entries": {
            "type": "integer",
            "title": "最多采纳条数",
            "minimum": 1,
            "maximum": 10,
            "default": 3
          },
          "scope": {
            "type": "string",
            "title": "使用范围",
            "enum": [
              "story_01_05",
              "image_06",
              "performance_07",
              "camera_08",
              "full"
            ]
          },
          "require_confirmed": {
            "type": "boolean",
            "title": "必须已确认",
            "default": true
          },
          "note": {
            "type": "string",
            "title": "备注"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "executor": "knowledge_adopt",
      "parallel_safe": false
    },
    {
      "type": "style_bind",
      "label": "风格卡绑定",
      "category": "风格",
      "description": "把项目已应用的风格卡写入参考记忆（style_reference），并绑定 06/08 使用范围。",
      "ports": {
        "in": [
          "style_card",
          "state"
        ],
        "out": [
          "reference",
          "log"
        ]
      },
      "params_schema": {
        "type": "object",
        "properties": {
          "style": {
            "type": "string",
            "title": "风格编号（未应用时自动应用）"
          },
          "tool": {
            "type": "string",
            "title": "目标工具",
            "enum": [
              "mj",
              "banana",
              "sd",
              "seedance_2_0",
              "seedance_2_5",
              "h3",
              "runway",
              "pika"
            ]
          },
          "scope": {
            "type": "array",
            "title": "使用范围",
            "items": {
              "type": "string",
              "enum": [
                "image_06",
                "performance_07",
                "camera_08",
                "full"
              ]
            },
            "minItems": 1
          },
          "note": {
            "type": "string",
            "title": "备注"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "executor": "style_bind",
      "parallel_safe": false
    },
    {
      "type": "generate",
      "label": "生成提交",
      "category": "生成",
      "description": "通过生成平台适配层提交提示词；默认 dry-run，显式 live 且配置 key 才发起真实请求。",
      "ports": {
        "in": [
          "state",
          "text"
        ],
        "out": [
          "generation",
          "log"
        ]
      },
      "params_schema": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "title": "生成平台",
            "enum": [
              "mock",
              "seedance_2_0",
              "seedance_2_5",
              "minimax_h3"
            ],
            "default": "mock"
          },
          "model": {
            "type": "string",
            "title": "模型（留空用默认）"
          },
          "prompt_path": {
            "type": "string",
            "title": "提示词文件（相对项目）"
          },
          "shot": {
            "type": "string",
            "title": "镜头编号"
          },
          "live": {
            "type": "boolean",
            "title": "真实提交",
            "default": false
          },
          "note": {
            "type": "string",
            "title": "备注"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "executor": "generate",
      "parallel_safe": false
    },
    {
      "type": "generate_refresh",
      "label": "生成状态查询",
      "category": "生成",
      "description": "查询生成平台任务状态并更新本地记录：指定 job_id 刷单个任务，all=true 批量刷新 submitted 任务。",
      "ports": {
        "in": [
          "state",
          "generation"
        ],
        "out": [
          "generation",
          "log"
        ]
      },
      "params_schema": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string",
            "title": "任务 ID（留空且 all=false 时报错）"
          },
          "all": {
            "type": "boolean",
            "title": "批量刷新 submitted 任务",
            "default": false
          },
          "limit": {
            "type": "integer",
            "title": "批量刷新最多扫描条数",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "note": {
            "type": "string",
            "title": "备注"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "executor": "generate_refresh"
    },
    {
      "type": "generate_adopt",
      "label": "生成结果回填",
      "category": "生成",
      "description": "把 succeeded 任务结果回填为项目产物（写凭证 JSON 并登记 state.stage_artifacts）：指定 job_id 回填单个，all=true 批量回填。",
      "ports": {
        "in": [
          "state",
          "generation"
        ],
        "out": [
          "artifact",
          "log"
        ]
      },
      "params_schema": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string",
            "title": "任务 ID（留空且 all=false 时报错）"
          },
          "all": {
            "type": "boolean",
            "title": "批量回填全部 succeeded 任务",
            "default": false
          },
          "limit": {
            "type": "integer",
            "title": "批量回填最多扫描条数",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "stage": {
            "type": "string",
            "title": "登记阶段",
            "enum": [
              "01",
              "02",
              "03",
              "04",
              "05",
              "06",
              "07",
              "08"
            ],
            "default": "05"
          },
          "kind": {
            "type": "string",
            "title": "产物类型",
            "default": "generation"
          },
          "note": {
            "type": "string",
            "title": "备注"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "executor": "generate_adopt",
      "parallel_safe": false
    },
    {
      "type": "confirm",
      "label": "人工确认",
      "category": "控制",
      "description": "运行断点：展示确认信息，等待用户确认后才继续下游。",
      "ports": {
        "in": [
          "artifact",
          "knowledge_card",
          "style_card",
          "injection",
          "text",
          "card",
          "log"
        ],
        "out": [
          "confirmed"
        ]
      },
      "params_schema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "title": "确认提示"
          },
          "detail_path": {
            "type": "string",
            "title": "详情文件（可空）"
          },
          "note": {
            "type": "string",
            "title": "备注"
          }
        },
        "required": [
          "prompt"
        ],
        "additionalProperties": false
      },
      "executor": "confirm"
    },
    {
      "type": "export",
      "label": "导出项目",
      "category": "输出",
      "description": "把项目打包为可移交的 zip（导出产物与状态）。",
      "ports": {
        "in": [
          "state"
        ],
        "out": [
          "artifact",
          "log"
        ]
      },
      "params_schema": {
        "type": "object",
        "properties": {
          "out": {
            "type": "string",
            "title": "输出 zip 路径（可空=默认）"
          },
          "note": {
            "type": "string",
            "title": "备注"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "executor": "export",
      "parallel_safe": true
    },
    {
      "type": "end",
      "label": "结束",
      "category": "控制",
      "description": "流程终点。",
      "ports": {
        "in": [
          "any"
        ],
        "out": []
      },
      "params_schema": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string",
            "title": "备注"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "executor": "end",
      "parallel_safe": true
    }
  ]
}
